{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wavero-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wavero-db",
      "database_id": "2e1c715c-896e-4f78-9d44-fa19f2ce54e2"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
